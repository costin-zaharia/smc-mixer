{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "HomeAssistant": {
    "BaseUrl": "http://localhost:8123",
    "TokenFile": "~/.config/smc-ha/token",
    "MinCallIntervalMs": 100,
    "KelvinPerTick": 100,
    "Mappings": [
      { "Control": "Fader 1", "Action": "Brightness", "Entity": "light.bedroom_light_bulb_bed_room" },
      { "Control": "Knob 1", "Action": "ColorTemperature", "Entity": "light.bedroom_light_bulb_bed_room" },
      { "Control": "Mute 1", "Action": "Toggle", "Entity": "light.bedroom_light_bulb_bed_room" },

      { "Control": "Fader 2", "Action": "Brightness", "Entity": "light.living_room_light_bulb_living_room" },
      { "Control": "Knob 2", "Action": "ColorTemperature", "Entity": "light.living_room_light_bulb_living_room" },
      { "Control": "Mute 2", "Action": "Toggle", "Entity": "light.living_room_light_bulb_living_room" }
    ]
  }
}
