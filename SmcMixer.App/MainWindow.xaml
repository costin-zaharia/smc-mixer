<Window x:Class="SmcMixer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmcMixer.App"
        Title="SMC Mixer" Width="1060" Height="580" MinWidth="1000" MinHeight="540"
        Background="#16161A" FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate x:Key="LedButton" DataType="{x:Type local:ButtonVm}">
            <Border Width="40" Height="30" Margin="0,4" CornerRadius="5"
                    Background="{Binding Fill}" Effect="{Binding Glow}"
                    BorderBrush="#40FFFFFF" BorderThickness="1">
                <TextBlock Text="{Binding Label}" Foreground="{Binding LabelBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Strip" DataType="{x:Type local:StripVm}">
            <Border Margin="4,0" Padding="8" CornerRadius="8" Background="#1F1F25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <local:KnobControl Grid.ColumnSpan="2" Width="54" Height="54" Margin="0,2,0,12"
                                       Angle="{Binding KnobAngle}"/>
                    <local:FaderControl Grid.Row="1" Width="44" Height="250" HorizontalAlignment="Center"
                                        VerticalAlignment="Top" Value="{Binding Fader}"/>
                    <ItemsControl Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top"
                                  ItemsSource="{Binding Buttons}" ItemTemplate="{StaticResource LedButton}"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Index}" Foreground="#77777F"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#8A8A92" Margin="0,12,0,0"/>

        <ItemsControl DockPanel.Dock="Bottom" Margin="0,12,0,0" ItemsSource="{Binding Transport}"
                      ItemTemplate="{StaticResource LedButton}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="6,0"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Strips}" ItemTemplate="{StaticResource Strip}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DockPanel>
</Window>
